# ---------- Core ----------
ENVIRONMENT=development           # development | staging | production
SECRET_KEY=                       # 32+ random bytes, used for signing manage-tokens
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Database (Neon) ----------
DATABASE_URL=                     # pooled connection string, for the app
DIRECT_DATABASE_URL=              # direct connection string, for Alembic

# ---------- Feature flags ----------
TEST_PROVIDER_ENABLED=true        # in-house simulated rail, for demoing the flow with no live payment creds
STRIPE_ENABLED=false              # keep false until a US/UK entity exists
PAYPAL_ENABLED=false              # true at launch once PAYPAL_CLIENT_ID/SECRET are supplied
MPESA_ENABLED=false               # true at launch once Daraja creds are supplied
BTC_ENABLED=false                 # keep false for launch

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- PayPal ----------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox               # sandbox | live
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ---------- M-Pesa (Safaricom Daraja) ----------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox         # sandbox | production
MPESA_CALLBACK_URL=               # must be public HTTPS, no query string
MPESA_RATIBA_CALLBACK_URL=

# ---------- Bitcoin ----------
BTC_PROVIDER=btcpay               # btcpay | opennode | coinbase_commerce
BTC_API_KEY=
BTC_STORE_ID=
BTC_WEBHOOK_SECRET=
BTC_MIN_CONFIRMATIONS=2

# ---------- Email ----------
EMAIL_PROVIDER=console            # console (dev, logs only) | smtp
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="The Bridge of Hope Foundation <giving@REPLACE-ME.org>"
EMAIL_REPLY_TO=

# ---------- Admin ----------
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=              # argon2 hash, never a plaintext password

# ---------- Ops ----------
SENTRY_DSN=
LOG_LEVEL=INFO
